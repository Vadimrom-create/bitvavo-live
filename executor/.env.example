# NEVER commit real values. Copy this file to /etc/bitvavo-executor.env on the private VM.
BITVAVO_API_KEY=
BITVAVO_API_SECRET=

# Free integer chosen by us to identify every order created by this executor.
BITVAVO_OPERATOR_ID=26090701

# Safety defaults. Live mode will remain disabled until end-to-end tests pass.
DRY_RUN=true
MAX_ORDER_EUR=600
MAX_TOTAL_NEW_EXPOSURE_EUR=1200
MAX_ENTRY_PRICE_DRIFT_PCT=0.50
MAX_SPREAD_PCT=0.60
APPROVAL_MAX_AGE_SECONDS=600

# Public approval relay. ChatGPT writes this file only after the user explicitly says yes.
APPROVAL_URL=https://raw.githubusercontent.com/Vadimrom-create/bitvavo-live/main/trade_approval.json
POLL_SECONDS=4

# Local state only; never published.
STATE_DIR=/var/lib/bitvavo-executor

# Security behavior. Keep false during installation/test; enable only after observing existing/manual orders.
AUTO_CANCEL_UNKNOWN_ORDERS=false
SECURITY_FREEZE_ON_UNKNOWN=true
